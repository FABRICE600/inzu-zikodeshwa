# GEMINI_API_KEY: Optional for future AI features.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this application is hosted online.
APP_URL="MY_APP_URL"

# NODE_ENV & PORT: Production hosting settings (port 3000 default).
NODE_ENV="production"
PORT="3000"

# JWT_SECRET: Strong random secret key used to sign user session tokens.
JWT_SECRET="change-me-in-production-rwanda-rental-finder"

# PostgreSQL / Cloud SQL connection parameters:
SQL_HOST="127.0.0.1"
SQL_USER="postgres"
SQL_PASSWORD="YOUR_DB_PASSWORD"
SQL_DB_NAME="inzufinder"
